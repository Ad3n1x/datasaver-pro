{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://datasaver-pro.onrender.com/api/:match*"
    },
    {
      "source": "/browse",
      "destination": "https://datasaver-pro.onrender.com/browse"
    },
    {
      "source": "/proxy.pac",
      "destination": "https://datasaver-pro.onrender.com/proxy.pac"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Developer",
          "value": "Ad3n1x (https://github.com/Ad3n1x)"
        },
        {
          "key": "X-Powered-By",
          "value": "DataSaver Pro by Ad3n1x"
        },
        {
          "key": "X-Backend-Origin",
          "value": "https://datasaver-pro.onrender.com"
        },
        {
          "key": "X-Author",
          "value": "Ad3n1x"
        }
      ]
    }
  ]
}
