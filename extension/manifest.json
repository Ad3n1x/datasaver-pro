{
  "manifest_version": 3,
  "name": "DataSaver Pro - Bandwidth Reducer by Ad3n1x",
  "version": "1.2.0",
  "description": "Reduces browser data usage by up to 80% with Save-Data headers, video autoplay blocking, and image optimization. Developed by Ad3n1x.",
  "author": "Ad3n1x <adenix271@gmail.com>",
  "homepage_url": "https://github.com/Ad3n1x/datasaver-pro",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DataSaver Pro by Ad3n1x"
  }
}
